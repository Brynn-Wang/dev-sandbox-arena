# Demo mode needs no secrets and keeps learning progress in the browser.
RUN_MODE=demo
DEMO_MODE=true

# Supabase (required only when RUN_MODE=connected)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-example-not-a-real-key

# Optional OpenAI-compatible server adapter
LLM_BASE_URL=https://example.invalid/v1
LLM_MODEL=replace-with-model-id
LLM_API_KEY=server-only-example-not-a-real-key
